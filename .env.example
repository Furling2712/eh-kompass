# Mitarbeiter-Passwort-Hash (nicht das Passwort selbst!).
# Erzeugen mit: npm run staff:hash -- "DeinPasswort"
STAFF_PASSWORD_HASH=

# Geheimer Schlüssel zum Signieren der Mitarbeiter-Login-Sitzung.
# Einmalig erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_SESSION_SECRET=

# Zugangscode-Hash für die Online-BeWo-Video-Sprechstunde (nicht der Code selbst!).
# Erzeugen mit: npm run bewo:hash -- "DeinZugangscode"
CLIENT_PASSWORD_HASH=

# Geheimer Schlüssel zum Signieren der Klienten-Login-Sitzung. Bewusst getrennt von
# STAFF_SESSION_SECRET, damit ein Klienten-Code niemals eine Mitarbeiter-Sitzung fälschen kann.
# Einmalig erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLIENT_SESSION_SECRET=

# API-Key von resend.com für den Versand der Fortbildungs-Zugangslinks/-Erinnerungen.
# Braucht eine in Resend verifizierte Domain eh-kompass.de (DNS-Einträge), siehe src/lib/fortbildungen.ts.
RESEND_API_KEY=

# Admin-Passwort-Hash für die Fortbildungs-Gesamtübersicht (/mitarbeiter/fortbildungen), nicht das
# Passwort selbst! Bewusst getrennt vom Mitarbeiter-Passwort oben, damit nicht jede Person mit dem
# geteilten Mitarbeiter-Login die Fortbildungs-Nachweise aller Kolleg:innen sehen kann.
# Erzeugen mit: npm run admin:hash -- "DeinAdminPasswort"
ADMIN_PASSWORD_HASH=

# Geheimer Schlüssel zum Signieren der Admin-Sitzung. Bewusst getrennt von STAFF_SESSION_SECRET.
# Einmalig erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Geheimer Schlüssel für die persönlichen Fortbildungs-Status-Links der Mitarbeiter:innen
# (/fortbildungen/status/[token]). Kein Passwort, wird nie eingegeben, nur zum Signieren/Prüfen
# des Tokens verwendet.
# Einmalig erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATUS_LINK_SECRET=
