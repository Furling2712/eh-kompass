---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Danke für euer Feedback" noindex>
  <div class="container prose article">
    <h1>Danke!</h1>
    <p class="lead muted">
      Eure Nachricht ist bei uns angekommen. Wir melden uns, falls ihr eine E-Mail-Adresse
      angegeben habt und eine Antwort sinnvoll ist.
    </p>
    <p><a href="/bewo-anbieter/" class="btn btn-secondary">← Zurück zur Übersicht für BeWo-Anbieter</a></p>
  </div>
</BaseLayout>

<style>
  .article {
    padding-block: 2.5rem 1rem;
  }
</style>
