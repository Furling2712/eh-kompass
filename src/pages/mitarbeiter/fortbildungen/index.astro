---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { STATUS_LINK_SECRET } from 'astro:env/server';
import { mitarbeiterListe } from '../../../data/mitarbeiter';
import { fortbildungen } from '../../../data/fortbildungen';
import { ladeAlleStatus, faelligkeitsDatum, statusLink, type StatusEintrag } from '../../../lib/fortbildungen';

let alleStatus: StatusEintrag[] = [];
let ladeFehler = '';
try {
  alleStatus = await ladeAlleStatus();
} catch (err) {
  ladeFehler = err instanceof Error ? err.message : String(err);
}

const statusMap = new Map(alleStatus.map((s) => [`${s.mitarbeiterId}:${s.fobiId}`, s]));

interface Zelle {
  fobiId: string;
  fobiTitel: string;
  zustand: 'offen' | 'bestanden' | 'faellig';
  tooltip: string;
  faelligAb: number | null;
}

interface MitarbeiterZeile {
  mitarbeiterId: string;
  name: string;
  zellen: Zelle[];
  naechsteAuffrischung: { datum: number; ueberfaellig: boolean; fobiTitel: string } | null;
  offenAnzahl: number;
}

const zeilen: MitarbeiterZeile[] = mitarbeiterListe.map((m) => {
  const zellen: Zelle[] = fortbildungen.map((f) => {
    const status = statusMap.get(`${m.id}:${f.id}`);
    if (!status) {
      return { fobiId: f.id, fobiTitel: f.titel, zustand: 'offen' as const, tooltip: 'Noch nie gemacht', faelligAb: null };
    }
    const faelligAb = faelligkeitsDatum(status.zuletztBestandenAm, f.gueltigkeitMonate);
    const bestandenDatum = new Date(status.zuletztBestandenAm).toLocaleDateString('de-DE');
    if (Date.now() >= faelligAb) {
      return {
        fobiId: f.id,
        fobiTitel: f.titel,
        zustand: 'faellig' as const,
        tooltip: `Zuletzt bestanden am ${bestandenDatum} — Auffrischung fällig seit ${new Date(faelligAb).toLocaleDateString('de-DE')}`,
        faelligAb,
      };
    }
    return {
      fobiId: f.id,
      fobiTitel: f.titel,
      zustand: 'bestanden' as const,
      tooltip: `Bestanden am ${bestandenDatum} — nächste Auffrischung ab ${new Date(faelligAb).toLocaleDateString('de-DE')}`,
      faelligAb,
    };
  });

  const bekannteFaelligkeiten = zellen.filter(
    (z): z is Zelle & { faelligAb: number } => z.faelligAb !== null
  );
  const naechste = [...bekannteFaelligkeiten].sort((a, b) => a.faelligAb - b.faelligAb)[0];
  const offenAnzahl = zellen.filter((z) => z.zustand === 'offen').length;

  return {
    mitarbeiterId: m.id,
    name: m.name,
    zellen,
    naechsteAuffrischung: naechste ? { datum: naechste.faelligAb, ueberfaellig: naechste.zustand === 'faellig', fobiTitel: naechste.fobiTitel } : null,
    offenAnzahl,
  };
});

const anzahlOffenGesamt = zeilen.reduce((sum, z) => sum + z.offenAnzahl, 0);
const anzahlFaelligGesamt = zeilen.reduce((sum, z) => sum + z.zellen.filter((c) => c.zustand === 'faellig').length, 0);
const anzahlAktuellGesamt = zeilen.reduce((sum, z) => sum + z.zellen.filter((c) => c.zustand === 'bestanden').length, 0);
const gesamtAnzahlZellen = zeilen.length * fortbildungen.length;

const ersterMitarbeiter = mitarbeiterListe[0];
const anfangsLink = ersterMitarbeiter ? statusLink(ersterMitarbeiter.id, STATUS_LINK_SECRET) : '';
---

<BaseLayout title="Pflicht-Fortbildungen" noindex>
  <div class="container article">
    <div class="prose">
      <h1>Pflicht-Fortbildungen</h1>
      <p class="lead muted">
        Übersicht, wer welche Pflicht-Fortbildung absolviert hat, und Versand neuer Zugangslinks per
        Mail. Admin-Bereich mit eigenem Passwort, getrennt vom normalen Mitarbeiter-Login – so sieht
        nicht jede Person mit dem geteilten Mitarbeiter-Passwort die Nachweise aller Kolleg:innen.
        Der Test selbst läuft über einen persönlichen Link außerhalb des Mitarbeiter-Logins.
      </p>

      {ladeFehler && (
        <div class="notice">
          <strong>Status konnte nicht geladen werden.</strong>
          <p style="margin-bottom:0">{ladeFehler}</p>
        </div>
      )}
    </div>

    <div class="tool-box tool-box-wide">
      <div class="status-head">
        <h2>Status</h2>
        {zeilen.length > 0 && (
          <button type="button" id="csv-export" class="btn btn-secondary">Als CSV exportieren</button>
        )}
      </div>
      {gesamtAnzahlZellen > 0 && (
        <p class="small muted status-summary">
          <strong>{anzahlFaelligGesamt + anzahlOffenGesamt}</strong> von {gesamtAnzahlZellen} brauchen Aktion
          ({anzahlFaelligGesamt} fällig zur Auffrischung, {anzahlOffenGesamt} noch nie gemacht) ·{' '}
          {anzahlAktuellGesamt} aktuell
        </p>
      )}
      {zeilen.length === 0 || fortbildungen.length === 0 ? (
        <p class="small muted">
          Noch keine Mitarbeiter oder Fortbildungen hinterlegt (<code>src/data/mitarbeiter.ts</code>,{' '}
          <code>src/data/fortbildungen.ts</code>).
        </p>
      ) : (
        <div class="table-scroll">
          <table class="status-tabelle status-matrix">
            <thead>
              <tr>
                <th>Mitarbeiter</th>
                {fortbildungen.map((f) => <th>{f.titel}</th>)}
                <th>Nächste Auffrischung nötig am</th>
              </tr>
            </thead>
            <tbody>
              {zeilen.map((z) => (
                <tr>
                  <td>{z.name}</td>
                  {z.zellen.map((c) => (
                    <td class="status-zelle">
                      <span
                        class={`status-check status-check-${c.zustand}`}
                        title={c.tooltip}
                        aria-label={`${c.fobiTitel}: ${c.tooltip}`}
                      >
                        {c.zustand === 'bestanden' ? '✓' : c.zustand === 'faellig' ? '!' : '✗'}
                      </span>
                    </td>
                  ))}
                  <td>
                    {z.naechsteAuffrischung ? (
                      <span
                        class={z.naechsteAuffrischung.ueberfaellig ? 'text-faellig' : ''}
                        title={`${z.naechsteAuffrischung.fobiTitel} — ${z.naechsteAuffrischung.ueberfaellig ? 'fällig seit' : 'fällig ab'} ${new Date(z.naechsteAuffrischung.datum).toLocaleDateString('de-DE')}`}
                        style="cursor:help"
                      >
                        {new Date(z.naechsteAuffrischung.datum).toLocaleDateString('de-DE')}
                        {z.naechsteAuffrischung.ueberfaellig ? ' (überfällig)' : ''}
                      </span>
                    ) : (
                      <span class="muted small">–</span>
                    )}
                    {z.offenAnzahl > 0 && (
                      <p class="small muted" style="margin:.25rem 0 0">
                        {z.offenAnzahl} Fortbildung{z.offenAnzahl > 1 ? 'en' : ''} noch nie gemacht
                      </p>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <div class="prose">
      <div class="tool-box">
        <h2>Zugangslink senden</h2>
        <p class="small muted" style="margin-top:0">
          Verschickt einen persönlichen Test-Link per Mail. Die automatische Jahres-Erinnerung läuft
          separat, dieses Formular ist für den Erstversand oder manuelles Nachschicken.
        </p>
        <form id="versand-form">
          <div class="field">
            <label for="mitarbeiterId">Mitarbeiter</label>
            <select id="mitarbeiterId" name="mitarbeiterId" required>
              {mitarbeiterListe.map((m) => (
                <option value={m.id}>{m.name}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="fobiId">Fortbildung</label>
            <select id="fobiId" name="fobiId" required>
              {fortbildungen.map((f) => (
                <option value={f.id}>{f.titel}</option>
              ))}
            </select>
          </div>
          <button type="submit" class="btn">Link senden</button>
        </form>
        <p id="versand-ergebnis" class="small" hidden></p>
      </div>

      <div class="tool-box">
        <h2>Persönlicher Status-Link</h2>
        <p class="small muted" style="margin-top:0">
          Jede Mitarbeiter:in bekommt ihren eigenen Link automatisch mit jeder Zugangs-/Erinnerungsmail
          zugeschickt. Hier zum gezielten Nachschlagen für eine einzelne Person (z. B. beim Onboarding),
          ohne die Links aller Kolleg:innen auf einen Blick zu zeigen.
        </p>
        {mitarbeiterListe.length === 0 ? (
          <p class="small muted">Noch keine Mitarbeiter hinterlegt (<code>src/data/mitarbeiter.ts</code>).</p>
        ) : (
          <>
            <div class="field">
              <label for="statusLinkMitarbeiter">Mitarbeiter</label>
              <select id="statusLinkMitarbeiter">
                {mitarbeiterListe.map((m) => (
                  <option value={m.id} data-link={statusLink(m.id, STATUS_LINK_SECRET)}>{m.name}</option>
                ))}
              </select>
            </div>
            <div class="status-link-anzeige">
              <input
                type="text"
                readonly
                id="statusLinkFeld"
                value={anfangsLink}
                onclick="this.select()"
                class="status-link-feld"
              />
              <button type="button" id="statusLinkKopieren" class="btn btn-secondary">Kopieren</button>
            </div>
            <p id="statusLinkKopiertHinweis" class="small muted" hidden></p>
          </>
        )}
      </div>

      <p>
        <a href="/mitarbeiter/" class="btn btn-secondary">← Zurück zum Mitarbeiterbereich</a>
      </p>
      <form method="POST" action="/mitarbeiter/fortbildungen/logout">
        <button type="submit" class="btn btn-secondary">Admin abmelden</button>
      </form>
    </div>
  </div>
</BaseLayout>

<style>
  .article {
    padding-block: 2.5rem 1rem;
  }
  .tool-box h2 {
    margin-top: 0;
  }
  .tool-box-wide {
    max-width: none;
  }
  .status-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .status-head h2 {
    margin-bottom: 0;
  }
  .status-summary {
    margin: 0 0 1.25rem;
  }
  .table-scroll {
    overflow-x: auto;
  }
  .status-tabelle {
    width: 100%;
    border-collapse: collapse;
  }
  .status-tabelle th,
  .status-tabelle td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
    white-space: nowrap;
  }
  .status-matrix th:first-child,
  .status-matrix td:first-child {
    white-space: normal;
  }
  .status-zelle {
    text-align: center;
  }
  .status-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    font-weight: 700;
    cursor: help;
  }
  .status-check-bestanden {
    background: #2e7d32;
    color: #fff;
  }
  .status-check-faellig {
    background: #b3261e;
    color: #fff;
  }
  .status-check-offen {
    background: var(--color-surface);
    color: var(--color-muted, inherit);
    border: 1px solid var(--color-border);
  }
  .text-faellig {
    color: #b3261e;
    font-weight: 600;
  }
  .status-link-anzeige {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .status-link-feld {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.85rem;
    font-family: monospace;
    background: var(--color-surface);
  }
</style>

<script>
  const form = document.getElementById('versand-form') as HTMLFormElement;
  const ergebnis = document.getElementById('versand-ergebnis') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    ergebnis.hidden = false;
    ergebnis.textContent = 'Sende Link …';

    const formData = new FormData(form);
    try {
      const res = await fetch('/mitarbeiter/fortbildungen/api/versand', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          mitarbeiterId: formData.get('mitarbeiterId'),
          fobiId: formData.get('fobiId'),
        }),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        ergebnis.textContent = 'Link wurde per Mail verschickt.';
      } else {
        ergebnis.textContent = `Fehler beim Versand: ${data.detail ?? data.error ?? 'unbekannt'}`;
      }
    } catch (err) {
      ergebnis.textContent = `Fehler beim Versand: ${err instanceof Error ? err.message : String(err)}`;
    } finally {
      submitBtn.disabled = false;
    }
  });

  const csvBtn = document.getElementById('csv-export');
  if (csvBtn) {
    csvBtn.addEventListener('click', () => {
      const table = document.querySelector('.status-tabelle') as HTMLTableElement;
      const escape = (v: string) => `"${v.replace(/"/g, '""')}"`;
      const headerCells = Array.from(table.querySelectorAll('thead th')).map(
        (th) => th.textContent?.trim() ?? ''
      );
      const rows = Array.from(table.querySelectorAll('tbody tr'));
      const csvZeilen = rows.map((row) => {
        const cells = Array.from(row.children);
        const werte = cells.map((cell, i) => {
          if (i === 0 || i === cells.length - 1) {
            return cell.textContent?.replace(/\s+/g, ' ').trim() ?? '';
          }
          const check = cell.querySelector('.status-check');
          return check?.getAttribute('title') ?? '';
        });
        return werte.map(escape).join(';');
      });
      const csv = '﻿' + [headerCells.map(escape).join(';'), ...csvZeilen].join('\r\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `fobi-status-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });
  }

  const statusLinkSelect = document.getElementById('statusLinkMitarbeiter') as HTMLSelectElement | null;
  const statusLinkFeld = document.getElementById('statusLinkFeld') as HTMLInputElement | null;
  const statusLinkKopieren = document.getElementById('statusLinkKopieren') as HTMLButtonElement | null;
  const statusLinkHinweis = document.getElementById('statusLinkKopiertHinweis') as HTMLParagraphElement | null;

  if (statusLinkSelect && statusLinkFeld) {
    statusLinkSelect.addEventListener('change', () => {
      const option = statusLinkSelect.selectedOptions[0] as HTMLOptionElement | undefined;
      statusLinkFeld.value = option?.dataset.link ?? '';
      if (statusLinkHinweis) statusLinkHinweis.hidden = true;
    });
  }

  if (statusLinkKopieren && statusLinkFeld) {
    statusLinkKopieren.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(statusLinkFeld.value);
        if (statusLinkHinweis) {
          statusLinkHinweis.hidden = false;
          statusLinkHinweis.textContent = 'Kopiert!';
        }
      } catch {
        statusLinkFeld.select();
        if (statusLinkHinweis) {
          statusLinkHinweis.hidden = false;
          statusLinkHinweis.textContent = 'Konnte nicht automatisch kopiert werden – Feld ist markiert, Strg+C.';
        }
      }
    });
  }
</script>
