---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { STATUS_LINK_SECRET } from 'astro:env/server';
import { mitarbeiterListe } from '../../../data/mitarbeiter';
import { fortbildungen } from '../../../data/fortbildungen';
import { ladeAlleStatus, faelligkeitsDatum, statusLink, type StatusEintrag } from '../../../lib/fortbildungen';

let alleStatus: StatusEintrag[] = [];
let ladeFehler = '';
try {
  alleStatus = await ladeAlleStatus();
} catch (err) {
  ladeFehler = err instanceof Error ? err.message : String(err);
}

const statusMap = new Map(alleStatus.map((s) => [`${s.mitarbeiterId}:${s.fobiId}`, s]));

interface Zeile {
  mitarbeiterName: string;
  fobiTitel: string;
  mitarbeiterId: string;
  fobiId: string;
  zustand: 'offen' | 'bestanden' | 'faellig';
  hinweis: string;
}

const zeilen: Zeile[] = [];
for (const m of mitarbeiterListe) {
  for (const f of fortbildungen) {
    const status = statusMap.get(`${m.id}:${f.id}`);
    if (!status) {
      zeilen.push({
        mitarbeiterName: m.name,
        fobiTitel: f.titel,
        mitarbeiterId: m.id,
        fobiId: f.id,
        zustand: 'offen',
        hinweis: 'Noch nie gemacht',
      });
      continue;
    }
    const faelligAb = faelligkeitsDatum(status.zuletztBestandenAm, f.gueltigkeitMonate);
    const bestandenDatum = new Date(status.zuletztBestandenAm).toLocaleDateString('de-DE');
    if (Date.now() >= faelligAb) {
      zeilen.push({
        mitarbeiterName: m.name,
        fobiTitel: f.titel,
        mitarbeiterId: m.id,
        fobiId: f.id,
        zustand: 'faellig',
        hinweis: `Zuletzt bestanden am ${bestandenDatum} — Auffrischung fällig`,
      });
    } else {
      const faelligDatum = new Date(faelligAb).toLocaleDateString('de-DE');
      zeilen.push({
        mitarbeiterName: m.name,
        fobiTitel: f.titel,
        mitarbeiterId: m.id,
        fobiId: f.id,
        zustand: 'bestanden',
        hinweis: `Bestanden am ${bestandenDatum} — fällig ab ${faelligDatum}`,
      });
    }
  }
}

// Dringendste zuerst: fällig (überfällig) vor offen (nie gemacht) vor bestanden (aktuell).
const ZUSTAND_PRIORITAET: Record<Zeile['zustand'], number> = { faellig: 0, offen: 1, bestanden: 2 };
zeilen.sort((a, b) => {
  const prio = ZUSTAND_PRIORITAET[a.zustand] - ZUSTAND_PRIORITAET[b.zustand];
  return prio !== 0 ? prio : a.mitarbeiterName.localeCompare(b.mitarbeiterName, 'de');
});

const anzahlOffen = zeilen.filter((z) => z.zustand === 'offen').length;
const anzahlFaellig = zeilen.filter((z) => z.zustand === 'faellig').length;
const anzahlAktuell = zeilen.filter((z) => z.zustand === 'bestanden').length;
---

<BaseLayout title="Pflicht-Fortbildungen" noindex>
  <div class="container prose article">
    <h1>Pflicht-Fortbildungen</h1>
    <p class="lead muted">
      Übersicht, wer welche Pflicht-Fortbildung absolviert hat, und Versand neuer Zugangslinks per
      Mail. Admin-Bereich mit eigenem Passwort, getrennt vom normalen Mitarbeiter-Login – so sieht
      nicht jede Person mit dem geteilten Mitarbeiter-Passwort die Nachweise aller Kolleg:innen.
      Der Test selbst läuft über einen persönlichen Link außerhalb des Mitarbeiter-Logins.
    </p>

    {ladeFehler && (
      <div class="notice">
        <strong>Status konnte nicht geladen werden.</strong>
        <p style="margin-bottom:0">{ladeFehler}</p>
      </div>
    )}

    <div class="tool-box">
      <div class="status-head">
        <h2>Status</h2>
        {zeilen.length > 0 && (
          <button type="button" id="csv-export" class="btn btn-secondary">Als CSV exportieren</button>
        )}
      </div>
      {zeilen.length > 0 && (
        <p class="small muted status-summary">
          <strong>{anzahlFaellig + anzahlOffen}</strong> von {zeilen.length} brauchen Aktion
          ({anzahlFaellig} fällig zur Auffrischung, {anzahlOffen} noch nie gemacht) ·{' '}
          {anzahlAktuell} aktuell
        </p>
      )}
      {zeilen.length === 0 ? (
        <p class="small muted">
          Noch keine Mitarbeiter oder Fortbildungen hinterlegt (<code>src/data/mitarbeiter.ts</code>,{' '}
          <code>src/data/fortbildungen.ts</code>).
        </p>
      ) : (
        <table class="status-tabelle">
          <thead>
            <tr>
              <th>Mitarbeiter</th>
              <th>Fortbildung</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {zeilen.map((z) => (
              <tr>
                <td>{z.mitarbeiterName}</td>
                <td>{z.fobiTitel}</td>
                <td>
                  <span class={`badge badge-${z.zustand}`}>
                    {z.zustand === 'bestanden' ? 'Aktuell' : z.zustand === 'faellig' ? 'Fällig' : 'Offen'}
                  </span>
                  <p class="small muted" style="margin:.25rem 0 0">{z.hinweis}</p>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    <div class="tool-box">
      <h2>Zugangslink senden</h2>
      <p class="small muted" style="margin-top:0">
        Verschickt einen persönlichen Test-Link per Mail. Die automatische Jahres-Erinnerung läuft
        separat, dieses Formular ist für den Erstversand oder manuelles Nachschicken.
      </p>
      <form id="versand-form">
        <div class="field">
          <label for="mitarbeiterId">Mitarbeiter</label>
          <select id="mitarbeiterId" name="mitarbeiterId" required>
            {mitarbeiterListe.map((m) => (
              <option value={m.id}>{m.name}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="fobiId">Fortbildung</label>
          <select id="fobiId" name="fobiId" required>
            {fortbildungen.map((f) => (
              <option value={f.id}>{f.titel}</option>
            ))}
          </select>
        </div>
        <button type="submit" class="btn">Link senden</button>
      </form>
      <p id="versand-ergebnis" class="small" hidden></p>
    </div>

    <div class="tool-box">
      <h2>Persönliche Status-Links</h2>
      <p class="small muted" style="margin-top:0">
        Jede Mitarbeiter:in bekommt ihren eigenen Link automatisch mit jeder Zugangs-/Erinnerungsmail
        zugeschickt. Hier zum manuellen Weitergeben (z. B. beim Onboarding), ohne diese Übersicht zu
        teilen.
      </p>
      <ul class="status-link-liste">
        {mitarbeiterListe.map((m) => (
          <li>
            <span class="status-link-name">{m.name}</span>
            <input
              type="text"
              readonly
              value={statusLink(m.id, STATUS_LINK_SECRET)}
              onclick="this.select()"
              class="status-link-feld"
            />
          </li>
        ))}
      </ul>
    </div>

    <p>
      <a href="/mitarbeiter/" class="btn btn-secondary">← Zurück zum Mitarbeiterbereich</a>
    </p>
    <form method="POST" action="/mitarbeiter/fortbildungen/logout">
      <button type="submit" class="btn btn-secondary">Admin abmelden</button>
    </form>
  </div>
</BaseLayout>

<style>
  .article {
    padding-block: 2.5rem 1rem;
  }
  .tool-box h2 {
    margin-top: 0;
  }
  .status-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .status-head h2 {
    margin-bottom: 0;
  }
  .status-summary {
    margin: 0 0 1.25rem;
  }
  .status-tabelle {
    width: 100%;
    border-collapse: collapse;
  }
  .status-tabelle th,
  .status-tabelle td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .badge-bestanden {
    background: #2e7d32;
    color: #fff;
  }
  .badge-faellig {
    background: #b3261e;
    color: #fff;
  }
  .badge-offen {
    background: var(--color-surface);
    color: inherit;
  }
  .status-link-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .status-link-liste li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .status-link-name {
    font-weight: 600;
    min-width: 10rem;
  }
  .status-link-feld {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.85rem;
    font-family: monospace;
    background: var(--color-surface);
  }
</style>

<script>
  const form = document.getElementById('versand-form') as HTMLFormElement;
  const ergebnis = document.getElementById('versand-ergebnis') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    ergebnis.hidden = false;
    ergebnis.textContent = 'Sende Link …';

    const formData = new FormData(form);
    try {
      const res = await fetch('/mitarbeiter/fortbildungen/api/versand', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          mitarbeiterId: formData.get('mitarbeiterId'),
          fobiId: formData.get('fobiId'),
        }),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        ergebnis.textContent = 'Link wurde per Mail verschickt.';
      } else {
        ergebnis.textContent = `Fehler beim Versand: ${data.detail ?? data.error ?? 'unbekannt'}`;
      }
    } catch (err) {
      ergebnis.textContent = `Fehler beim Versand: ${err instanceof Error ? err.message : String(err)}`;
    } finally {
      submitBtn.disabled = false;
    }
  });

  const csvBtn = document.getElementById('csv-export');
  if (csvBtn) {
    csvBtn.addEventListener('click', () => {
      const rows = Array.from(document.querySelectorAll('.status-tabelle tbody tr'));
      const escape = (v: string) => `"${v.replace(/"/g, '""')}"`;
      const zeilen = rows.map((row) => {
        const cells = row.querySelectorAll('td');
        const mitarbeiter = cells[0]?.textContent?.trim() ?? '';
        const fobi = cells[1]?.textContent?.trim() ?? '';
        const badge = cells[2]?.querySelector('.badge')?.textContent?.trim() ?? '';
        const hinweis = cells[2]?.querySelector('p')?.textContent?.trim() ?? '';
        return [mitarbeiter, fobi, badge, hinweis].map(escape).join(';');
      });
      const csv = '\uFEFF' + ['Mitarbeiter;Fortbildung;Status;Hinweis', ...zeilen].join('\r\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `fobi-status-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });
  }
</script>
