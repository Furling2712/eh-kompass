---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Artikelsammlung: alle Ratgeber-Artikel zum freien Stöbern, alphabetisch statt in Leserichtung
// sortiert (die gibt's geführt im Ratgeber selbst, siehe /ratgeber/). Bewusst nicht in NAV_LINKS
// (src/consts.ts) aufgenommen — nur über den "Alle Artikel"-Link auf der Startseite erreichbar.
const articles = (await getCollection('ratgeber', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'de')
);
---

<BaseLayout
  title="Artikelsammlung"
  description="Alle Artikel rund um die Eingliederungshilfe auf einen Blick, zum freien Stöbern."
>
  <div class="container prose article" id="artikel-intro">
    <h1>Artikelsammlung</h1>
    <p class="lead muted">Alle Artikel auf einen Blick, zum freien Stöbern.</p>
  </div>

  <div class="container" id="artikel-liste">
    {
      articles.length === 0 ? (
        <p class="muted">Noch keine Artikel veröffentlicht.</p>
      ) : (
        <ul class="card-grid">
          {articles.map((a) => (
            <li class="card">
              <h3>
                <a href={`/ratgeber/${a.id}/`} class="card-link">
                  {a.data.title}
                </a>
              </h3>
              <p>{a.data.description}</p>
              <a href={`/ratgeber/${a.id}/`} class="small">
                Weiterlesen →
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .article {
    padding-block: 2.5rem 0.5rem;
  }
</style>
