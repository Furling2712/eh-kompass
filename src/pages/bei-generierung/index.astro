---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Bewusst als "Demnächst verfügbar"-Platzhalter ausgeblendet, solange der Checkout
// (Lemonsqueezy o.ä.) noch nicht eingerichtet ist. Die eigentlichen Unterseiten
// (bei-formular/, formatkonverter/) bleiben unverändert bestehen, sind aber von hier
// aus nicht mehr verlinkt. Volltext mit Preisen/Checkout-Buttons: siehe Git-Historie.
---

<BaseLayout
  title="BEI-Generierung"
  description="Für andere BeWo-Anbieter: Unterstützung bei der BEI-Generierung. Demnächst verfügbar."
>
  <div class="container prose article">
    <span class="badge">Digitalprodukt für BeWo-Anbieter</span>
    <h1>BEI-Generierung</h1>
    <p class="lead muted">
      Unterstützung bei der Bedarfsermittlung für andere Anbieter des Betreuten Wohnens – ihr
      beantwortet die Fragen des BEI-Formulars in Ruhe online, wir erstellen daraus eine fertig
      formulierte Vorlage.
    </p>

    <div class="notice">
      <strong>Demnächst verfügbar</strong>
      <p style="margin-bottom:0">
        Wir richten gerade den Bestellprozess ein. Meldet euch gerne über das
        <a href="/bewo-anbieter/">Feedback-Formular für BeWo-Anbieter</a>, wenn ihr informiert
        werden möchtet, sobald die BEI-Generierung startet.
      </p>
    </div>

    <p><a href="/bewo-anbieter/" class="btn btn-secondary">← Zurück zur Übersicht für BeWo-Anbieter</a></p>
  </div>
</BaseLayout>

<style>
  .article {
    padding-block: 2.5rem 1rem;
  }
</style>
