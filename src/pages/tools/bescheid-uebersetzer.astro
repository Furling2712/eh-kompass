---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
---

<BaseLayout
  title="Bescheid-Übersetzer"
  description="Foto vom Bescheid hochladen oder Text einfügen und typische Behördenformulierungen in einfacher Sprache erklärt bekommen. Läuft komplett in deinem Browser."
>
  <div class="container prose article">
    <span class="badge">Tool · Erkennung</span>
    <h1>Bescheid-Übersetzer</h1>
    <p class="lead muted">
      Foto von deinem Bescheid hochladen (oder Text direkt einfügen) – das Tool erkennt typische
      Behörden-Formulierungen und erklärt sie in einfacher Sprache.
    </p>

    <div class="notice">
      <strong>Läuft komplett in deinem Browser.</strong>
      <p style="margin-bottom:0">
        Dein Foto und der erkannte Text werden nirgends hochgeladen oder gespeichert – die
        Texterkennung läuft lokal auf deinem Gerät. Nur beim allerersten Aufruf lädt dein Browser
        das (anonyme) Erkennungsmodell aus dem Internet nach, dafür ist keine Anmeldung nötig und
        es werden keine Bild- oder Textinhalte von dir übertragen.
      </p>
    </div>

    <div class="tool-box" id="bescheid-tool">
      <div class="field">
        <label for="bild">Foto vom Bescheid (optional)</label>
        <input type="file" id="bild" name="bild" accept="image/*" capture="environment" />
        <p class="small muted" id="bild-hint" style="margin:.4rem 0 0">
          Am besten flach, gut ausgeleuchtet und ohne Schatten fotografieren – das verbessert die
          Erkennung deutlich.
        </p>
      </div>

      <img id="vorschau" alt="Vorschau des hochgeladenen Fotos" hidden />

      <button type="button" id="erkennen-btn" class="btn" disabled>Text aus Foto erkennen</button>
      <div id="ocr-status" class="small muted" style="margin-top:.5rem" hidden></div>

      <div class="field" style="margin-top:1.25rem">
        <label for="text">Erkannter Text (kannst du korrigieren oder auch direkt einfügen)</label>
        <textarea
          id="text"
          name="text"
          rows="8"
          placeholder="Text erscheint hier nach der Erkennung – oder füg direkt Text aus deinem Bescheid ein, z. B. per Copy &amp; Paste."
        ></textarea>
      </div>
    </div>

    <div id="begriffe-ergebnis"></div>

    <Disclaimer
      stand="August 2026"
      quelle="https://www.gesetze-im-internet.de/sgb_10/__24.html"
      quelleLabel="§ 24 SGB X (Anhörung)"
    />
  </div>
</BaseLayout>

<style>
  .article {
    padding-block: 2.5rem 1rem;
  }
  #vorschau {
    max-width: 100%;
    max-height: 20rem;
    display: block;
    margin: 1rem 0;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }
  #vorschau[hidden] {
    display: none;
  }
  textarea {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font: inherit;
    resize: vertical;
  }
  .begriff-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    margin: 0 0 1rem;
  }
  .begriff-card h3 {
    margin: 0 0 0.5rem;
  }
  .begriff-card p {
    margin: 0;
  }
  .begriff-card .mehr {
    display: inline-block;
    margin-top: 0.6rem;
  }
  #begriffe-leer {
    margin-top: 1.5rem;
  }
</style>

<script>
  import { bescheidBegriffe } from '../../data/bescheid-begriffe';

  const bildInput = document.getElementById('bild') as HTMLInputElement;
  const vorschau = document.getElementById('vorschau') as HTMLImageElement;
  const erkennenBtn = document.getElementById('erkennen-btn') as HTMLButtonElement;
  const ocrStatus = document.getElementById('ocr-status') as HTMLDivElement;
  const textFeld = document.getElementById('text') as HTMLTextAreaElement;
  const ergebnisBox = document.getElementById('begriffe-ergebnis') as HTMLDivElement;

  let ausgewaehlteDatei: File | null = null;

  bildInput.addEventListener('change', () => {
    const datei = bildInput.files?.[0] ?? null;
    ausgewaehlteDatei = datei;
    erkennenBtn.disabled = !datei;

    if (datei) {
      vorschau.src = URL.createObjectURL(datei);
      vorschau.hidden = false;
    } else {
      vorschau.hidden = true;
    }
  });

  erkennenBtn.addEventListener('click', async () => {
    if (!ausgewaehlteDatei) return;

    erkennenBtn.disabled = true;
    ocrStatus.hidden = false;
    ocrStatus.textContent = 'Erkennungsmodell wird geladen …';

    try {
      // Dynamischer Import: tesseract.js (~mehrere hundert KB) wird nur geladen, wenn dieses
      // Tool auch tatsächlich benutzt wird, nicht bei jedem Seitenaufruf.
      const { createWorker } = await import('tesseract.js');
      const worker = await createWorker('deu', 1, {
        logger: (m: { status: string; progress: number }) => {
          if (m.status === 'recognizing text') {
            ocrStatus.textContent = `Text wird erkannt … ${Math.round(m.progress * 100)}%`;
          } else {
            ocrStatus.textContent = `${m.status} …`;
          }
        },
      });

      const { data } = await worker.recognize(ausgewaehlteDatei);
      await worker.terminate();

      textFeld.value = data.text.trim();
      ocrStatus.textContent = 'Text erkannt. Prüf ihn kurz und korrigiere Tippfehler, falls nötig.';
      begriffeAktualisieren();
    } catch (err) {
      ocrStatus.textContent = `Erkennung fehlgeschlagen: ${err instanceof Error ? err.message : String(err)}`;
    } finally {
      erkennenBtn.disabled = false;
    }
  });

  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  textFeld.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(begriffeAktualisieren, 400);
  });

  // OCR-Text (und eingefügter Text aus PDFs) enthält oft Zeilenumbrüche mitten im Wort
  // ("Rechtsbehelfs-\nbelehrung") oder doppelte Leerzeichen. Ohne Normalisierung reißen genau
  // solche Umbrüche unsere Formulierungen auseinander und nichts matcht mehr.
  function normalisieren(text: string): string {
    return text
      .replace(/-\s*\n\s*/g, '') // Trennstrich am Zeilenende: Wort wieder zusammenfügen
      .replace(/\s+/g, ' ') // restliche Umbrüche/mehrfache Leerzeichen vereinheitlichen
      .trim();
  }

  function begriffeAktualisieren() {
    const text = normalisieren(textFeld.value);
    if (!text) {
      ergebnisBox.innerHTML = '';
      return;
    }

    const treffer = bescheidBegriffe.filter((b) => b.muster.some((muster) => muster.test(text)));

    if (treffer.length === 0) {
      ergebnisBox.innerHTML =
        '<p class="small muted" id="begriffe-leer">Keine der bekannten Standardformulierungen erkannt. Das Tool deckt nur typische, wiederkehrende Begriffe ab, nicht jeden möglichen Bescheid-Text.</p>';
      return;
    }

    ergebnisBox.innerHTML = `
      <h2>Erklärte Begriffe (${treffer.length})</h2>
      ${treffer
        .map(
          (b) => `
        <div class="begriff-card">
          <h3>${b.begriff}</h3>
          <p>${b.erklaerung}</p>
          ${b.mehr ? `<a href="${b.mehr.href}" class="small mehr">${b.mehr.label} →</a>` : ''}
        </div>
      `
        )
        .join('')}
    `;
  }
</script>
