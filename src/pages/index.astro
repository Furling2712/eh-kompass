---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_TAGLINE } from '../consts';

const articles = (await getCollection('ratgeber', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const tools = [
  {
    href: '/tools/fristenrechner',
    title: 'Fristenrechner',
    desc: 'Widerspruchsfrist ab Zustelldatum deines Bescheids berechnen.',
  },
  {
    href: '/tools/assistenzstunden-orientierung',
    title: 'Assistenzstunden-Orientierung',
    desc: 'Grobe Orientierung, welcher Unterstützungsumfang zu deiner Situation passen könnte.',
  },
  {
    href: '/tools/widerspruch-generator',
    title: 'Muster-Widerspruch-Generator',
    desc: 'Bausteinbasierter Entwurf für ein Widerspruchsschreiben zum Selbstanpassen.',
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <span class="badge">Eingliederungshilfe nach § 113 SGB IX</span>
      <h1>{SITE_TAGLINE}</h1>
      <p class="lead">
        Bescheid bekommen und nichts verstanden? Antrag steht an? Hier findest du einfache,
        praxisnahe Erklärungen und kostenlose Tools.
      </p>
      <div class="hero-actions" id="hero-actions">
        <a href="/ratgeber/" class="btn">Zum Ratgeber</a>
        <a href="/tools/" class="btn btn-secondary">Tools ausprobieren</a>
        <a href="/notfallzimmer/" class="btn btn-secondary">Notfallhilfe</a>
      </div>
    </div>
  </section>

  <section class="container section" id="starter-fragen">
    <h2>Womit fangen die meisten an?</h2>
    <ul class="card-grid">
      <li class="card">
        <h3>„Ich habe einen Bescheid bekommen“</h3>
        <p>
          Erst mal durchatmen. Die Checkliste führt dich in 5 Schritten ruhig durch alles
          Wichtige – von der Frist bis zur Frage, ob sich ein Widerspruch lohnt.
        </p>
        <a href="/ratgeber/bescheid-erhalten-was-tun/" class="btn btn-secondary">Checkliste ansehen</a>
      </li>
      <li class="card">
        <h3>„Ich verstehe die Abkürzungen nicht“</h3>
        <p>ICF, BEI, PerSEH, Regelbedarf – im Wörterbuch in verständlicher Sprache erklärt.</p>
        <a href="/glossar/" class="btn btn-secondary">Zum Wörterbuch</a>
      </li>
      <li class="card">
        <h3>„Ich will den Prozess von Anfang an verstehen“</h3>
        <p>Der Ratgeber führt dich Schritt für Schritt vom Antrag bis zum Hilfeplan.</p>
        <a href="/ratgeber/" class="btn btn-secondary">Zum Ratgeber</a>
      </li>
    </ul>
  </section>

  <section class="container section" id="tools-section">
    <div class="section-head">
      <h2>Kostenlose Tools</h2>
      <a href="/tools/" class="small">Alle Tools →</a>
    </div>
    <ul class="card-grid">
      {
        tools.map((t) => (
          <li class="card">
            <h3>
              <a href={t.href} class="card-link">
                {t.title}
              </a>
            </h3>
            <p>{t.desc}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {
    articles.length > 0 && (
      <section class="container section">
        <div class="section-head">
          <h2>Neue Artikel &ndash; aktuelle Themen</h2>
          <a href="/artikel/" class="small">Alle Artikel →</a>
        </div>
        <ul class="card-grid">
          {articles.map((a) => (
            <li class="card">
              <h3>
                <a href={`/ratgeber/${a.id}/`} class="card-link">
                  {a.data.title}
                </a>
              </h3>
              <p>{a.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="container section trust">
    <div class="trust-box" id="trust-box">
      <h2>Warum diese Seite?</h2>
      <p>
        Wir von PTV Euregio arbeiten unter anderem im psychiatrischen Betreuten Wohnen nach § 113
        SGB IX und begleiten Menschen durch Bedarfsermittlung, Hilfeplanung und Bescheide. Diese
        Seite soll dabei ein Anker sein – für Orientierung im Verfahren und für den Weg zu
        passender Unterstützung, verständlich und unabhängig aufbereitet aus echter
        Praxiserfahrung.
      </p>
      <a href="/impressum" class="btn btn-secondary">Impressum</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: 2.5rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .section-head h2 {
    margin-top: 0;
  }
  .card h3 {
    margin-bottom: 0.5rem;
  }
  .trust-box {
    background: var(--color-accent);
    border-radius: var(--radius);
    padding: 2rem;
    max-width: var(--readw);
  }
  .trust-box h2 {
    margin-top: 0;
  }
</style>
