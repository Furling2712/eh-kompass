---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrisisNotice from '../../components/CrisisNotice.astro';

const kostenlos = [
  {
    href: '/notfallzimmer/atemuebung',
    title: 'Box-Atmung',
    desc: 'Ein animierter Kreis führt dich durch einen ruhigen 4-4-4-4-Atemrhythmus.',
    icon: '🫁',
  },
  {
    href: '/notfallzimmer/erdung-54321',
    title: '5-4-3-2-1 Erdungsübung',
    desc: 'Schritt für Schritt über die Sinne zurück ins Hier und Jetzt.',
    icon: '🖐️',
  },
  {
    href: '/notfallzimmer/fokus-spiel',
    title: 'Blasen zerplatzen',
    desc: 'Ruhiges Ablenkungsspiel für den Kopf – ohne Punktedruck, ohne Verlieren.',
    icon: '🫧',
  },
];
---

<BaseLayout
  title="Notfallzimmer"
  description="Kostenlose Selbstregulations-Übungen für den Moment, in dem es gerade zu viel wird – Atmung, Erdung und Ablenkung."
>
  <div class="container prose article">
    <span class="badge">Für dich</span>
    <h1>Notfallzimmer</h1>
    <p class="lead muted">
      Werkzeuge für den Moment, wenn Anspannung, Ärger oder Krise gerade sehr hoch sind. Kurz,
      einfach, sofort nutzbar – ganz ohne Anmeldung.
    </p>

    <div id="notfallzimmer-crisis"><CrisisNotice /></div>

    <h2>Kostenlose Übungen</h2>
    <ul class="card-grid" id="notfallzimmer-kostenlos">
      {
        kostenlos.map((k) => (
          <li class="card">
            <h3>
              <a href={k.href} class="card-link">
                <span aria-hidden="true">{k.icon}</span> {k.title}
              </a>
            </h3>
            <p>{k.desc}</p>
            <a href={k.href} class="btn btn-secondary">
              Jetzt machen
            </a>
          </li>
        ))
      }
    </ul>

    <p class="hilfsmittel-link">
      <a href="/shop/skills/">
        Du benötigst häufiger Hilfsmittel? Hier findest du einige Produkte, die dir helfen können.
      </a>
    </p>
  </div>
</BaseLayout>

<style>
  .article {
    padding-block: 2.5rem 1rem;
  }
  .hilfsmittel-link {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-weight: 600;
  }
</style>
